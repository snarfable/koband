#!/bin/bash

idx=""
idxin=""
jobid=""
jobidin=""
stage=""
stagein=""
folderin=".."
while getopts "i:I:j:k:s:S:p:h" opt; do
    case ${opt} in
        h)
            echo "Usage: $(basename $0) [-h] [-i index] [I indexin] [-j jobid] [-k jobid_in] [-s stage] [-S stagein]"
            exit 0
            ;;
        i)
            idx="${OPTARG}"
            ;;
        I)
            idxin="${OPTARG}"
            ;;
        j)
            jobid="${OPTARG}"
            ;;
        k)
            jobidin="${OPTARG}"
            ;;
        s)
            stage="${OPTARG}"
            ;;
        S)
            stagein="${OPTARG}"
            ;;
	p)
	    folderin="${OPTARG}"
	    ;;
        ?|*)
            echo "No such option available."
            ;;
    esac
done
pref="${idx:+${idx}_}"
prefin="${idxin:+${idxin}_}"
suff="${jobid:+_${jobid}}"
suffin="${jobidin:+_${jobidin}}"
stage="${stage:+-${stage}}"
stagein="${stagein:+-${stagein}}"

# Check for presence of all required files
topol_file_in="${folderin}/${prefin}topol${stagein}${suffin}.top"
step_file_in="../${prefin}step${stage}${suffin}.mdp"
confin_file_in="${folderin}/${prefin}confin-box${stagein}${suffin}.gro"

# Mandatory copied outputs
topol_file_out="${pref}topol${stage}${suff}.top"
step_file_out="${pref}step${stage}${suff}.mdp"
confin_file_out="${pref}confin-box${stage}${suff}.gro"

# Optional copied outputs
trajin_file_out="${pref}trajin${stage}${suff}.trr"
index_file_out="${pref}index${stage}${suff}.ndx"

# Compiler outputs
tpr_file_out="${pref}topol${stage}${suff}.tpr"
mdout_file_out="${pref}mdout${stage}${suff}.mdp"
processed_file_out="${pref}processed${stage}${suff}.top"

if [ ! -f "${topol_file_in}" ]; then
    echo "Cannot find file ${topol_file_in}"
    exit 127 # Unsigned byte => -1
else
    cp ${topol_file_in} ${topol_file_out}
fi
if [ ! -f "${step_file_in}" ]; then
    echo "Cannot find file ${step_file_in}"
    exit 126 # Unsigned byte => -2
else
    cp ${step_file_in} ${step_file_out}
fi
if [ ! -f "${confin_file_in}" ]; then
    echo "Cannot find file ${confin_file_in}"
    exit 125 # Unsigned byte => -3
else
    cp ${confin_file_in} ${confin_file_out}
fi

# Identify locations of binaries needed
GMXBIN="$(python3 -c "from pathlib import Path; print(Path('gmx_mpi').resolve().parent)")"
GROMPP="gmx grompp"
MDRUN="gmx mdrun"

# Set the call string
MPIRUN_GROMPP=""
MPIARGS_GROMPP=""
EXENAME_GROMPP="${GROMPP}"
EXEARGS_GROMPP="-o ${tpr_file_out} \
    -p ${topol_file_out} \
    -f ${step_file_out} \
    -c ${confin_file_out} \
    -po ${mdout_file_out} \
    -pp ${processed_file_out} \
    -maxwarn 100"
if [ -f "${trajin_file_out}" ]; then
    EXEARGS_GROMPP="${EXEARGS_GROMPP} -t ${trajin_file_out}"
fi
if [ -f "${index_file_out}" ]; then
    EXEARGS_GROMPP="${EXEARGS_GROMPP} -n ${index_file_out}"
fi

# Set the call string for first step
CALL_STRING_GROMPP="${MPIRUN_GROMPP} ${MPIARGS_GROMPP} ${EXENAME_GROMPP} ${EXEARGS_GROMPP}"

# Output start and finish times
echo "Running in $(pwd)"
echo "Calling:"
echo ${CALL_STRING_GROMPP}
echo "Started at $(date)"
eval ${CALL_STRING_GROMPP}
echo "Finished ${EXENAME_GROMPP} at $(date)"

# Set up location of mpirun
MPIRUN_MDRUN=""
MPIARGS_MDRUN=""
ENVARGS_MDRUN="HWLOC_COMPONENTS=-gl DISPLAY= "
EXENAME_MDRUN="${MDRUN}"
EXEARGS_MDRUN="-v -c ${pref}confout-box${stage}${suff}.gro \
   -e ${pref}ener${stage}${suff}.edr \
   -g ${pref}md${stage}${suff}.log \
   -s ${pref}topol${stage}${suff}.tpr \
   -o ${pref}traj${stage}${suff}.trr \
   -x ${pref}traj${stage}${suff}.xtc \
   -cpo ${pref}state${stage}${suff}.cpt
   #-mtx ${pref}nm${stage}${suff}.mtx"

# If an index file of the appropriate index and jobid shows up
# then you can at least load it
if [ -f "${pref}index${stage}${suff}.ndx" ]; then
    EXEARGS_MDRUN="${EXEARGS_MDRUN} -n ${pref}index${stage}${suff}.ndx"
fi

# Important if using -ckpt in SGE or equivalent in any other queue
# Variable RESTARTED is available for SGE as far as I know; no guarantee
# for any other queue manager; writes a checkpoint every 5 minutes here
if [ $RESTARTED -eq 1 ] && [ -f "${pref}state${stage}${suff}.cpt" ]; then
    EXEARGS_MDRUN="${EXEARGS_MDRUN} -cpi ${pref}state${stage}${suff}.cpt -cpt 5 -append"
fi

# Set the call string
CALL_STRING_MDRUN="${ENVARGS_MDRUN} ${MPIRUN_MDRUN} ${MPIARGS_MDRUN} ${EXENAME_MDRUN} ${EXEARGS_MDRUN}"

# Output start and finish times
echo "Running in $(pwd)"
echo "Calling:"
echo ${CALL_STRING_MDRUN}
echo "Started at $(date)"
eval ${CALL_STRING_MDRUN}
echo "Finished ${EXENAME_MDRUN} at $(date)"

